# Copy to .env on the host. This is the image the box runs — not the git branch.
#
# Preview (CI on `dev`):
# LUMO_TAMER_IMAGE=ghcr.io/banter240/lumo-tamer:dev
#
# Pinned release (what you want on a server):
# LUMO_TAMER_IMAGE=ghcr.io/banter240/lumo-tamer:0.7.0
#
# Moving stable (only if you accept "whatever main last published"):
# LUMO_TAMER_IMAGE=ghcr.io/banter240/lumo-tamer:latest

LUMO_TAMER_IMAGE=ghcr.io/banter240/lumo-tamer:dev
